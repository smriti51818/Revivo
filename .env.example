# ════════════════════════════════════════════════════════════════
#  Revivo — environment configuration template
#  Copy to `.env` and fill in after `make infra-deploy`.
#  NEVER commit the real .env file.
# ════════════════════════════════════════════════════════════════

# ─── AWS core ───────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=000000000000

# ─── Cognito (from CDK output) ──────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=ap-south-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── API Gateway (from CDK output) ──────────────────────────────
API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

# ─── Storage / data (from CDK output) ───────────────────────────
S3_UPLOAD_BUCKET=revivo-uploads-xxxxxxxx
DYNAMO_TABLE_NAME=RevivoTable

# ─── Messaging (from CDK output) ────────────────────────────────
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:revivo-notifications
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/revivo-dlq

# ─── AI services ────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
REKOGNITION_MIN_CONFIDENCE=70

# ─── Business rules ─────────────────────────────────────────────
RESCUE_UNSOLD_HOURS=4
RESCUE_NO_ACCEPT_TIMEOUT_MIN=30
GPS_MAX_DISTANCE_METERS=500
PHOTO_MAX_AGE_MINUTES=10
